# mcp-jira-api — environment variables
#
# NOTE ON HOW THESE ARE LOADED. This server reads os.environ directly and does
# NOT load a .env file — there is no python-dotenv dependency and no
# load_dotenv() call anywhere in the repo. That is deliberate: an MCP server
# receives its environment from the MCP client, so the values below belong in
# the "env" block of your client config (for Claude Code, ~/.claude/settings.json
# under mcpServers -> jira-api), not in a .env file next to this one.
#
# This file is therefore documentation of WHICH variables exist, not a template
# to copy to .env. Copying it to .env will have no effect.
#
# Authoritative reference: README.md "Environment Variables".

# JIRA_URL — required. Base URL of your Jira instance, e.g.
# https://company.atlassian.net (Cloud) or https://jira.company.com (Server).
# A trailing slash is stripped.
JIRA_URL=your_value_here

# JIRA_USER — required. Email address for Jira Cloud, or username for Jira
# Server.
#
# NOTE: this file previously named this variable JIRA_EMAIL, which the code has
# never read — server.py reads JIRA_USER (4 call sites, zero for JIRA_EMAIL).
# Anyone who followed the old example got "Missing required Jira environment
# variables: JIRA_USER" with the value sitting right there under the wrong name.
JIRA_USER=your_value_here

# JIRA_API_TOKEN — required. API token for Jira Cloud (generate at
# https://id.atlassian.com/manage-profile/security/api-tokens), or a Personal
# Access Token / password for Jira Server.
JIRA_API_TOKEN=your_value_here

# JIRA_API_VERSION — optional, default "3". Use 3 for Jira Cloud (ADF body
# format) or 2 for Jira Server / Data Center (plain text).
# Read by server.py; was undocumented here.
JIRA_API_VERSION=3

# JIRA_AUTH_METHOD — optional, default "basic". "basic" sends
# Basic base64(user:token); "bearer" sends Bearer {token}, for a PAT on Jira
# Server. Read by server.py; was undocumented here.
JIRA_AUTH_METHOD=basic

# JIRA_STORY_POINTS_FIELD — optional, default "customfield_10016" (the Story
# Points field ID on Jira Cloud's out-of-box "Scrum" project template). Jira
# does not standardize this field's ID across instances/templates — if your
# project's Story Points field has a different custom field ID, set it here.
# Find yours via Jira admin -> Issues -> Custom fields, or by inspecting a
# Story issue's raw field payload. Read by jira_create_issue/jira_update_issue
# when their story_points argument is supplied.
JIRA_STORY_POINTS_FIELD=customfield_10016

# JIRA_DEFAULT_PROJECT — NOT IMPLEMENTED. Listed here because it was documented
# in an earlier version of this file and the intent is worth keeping visible,
# but no code reads it: project_key is a REQUIRED parameter on jira_create_issue
# and appears in 55 places across server.py, so honouring a default would mean
# making that parameter optional across the whole tool surface. That is a
# feature, not a documentation fix, and it is deliberately not bundled with one.
# Until it is implemented, pass project_key explicitly on every call.
# JIRA_DEFAULT_PROJECT=your_value_here
